[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/Title.gd" id="1_title"]

[node name="Title" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_title")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.09, 0.1, 1)

[node name="VBox" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -180.0
offset_right = 200.0
offset_bottom = 180.0
alignment = 1
theme_override_constants/separation = 24

[node name="TitleLabel" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 96
text = "SAINT"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(0.75, 0.8, 0.9, 1)
theme_override_font_sizes/font_size = 24
text = "세인트아이즈 클론 MVP"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 40)

[node name="StartButton" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 56)
theme_override_font_sizes/font_size = 28
text = "새로 시작"

[node name="ContinueButton" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 56)
theme_override_font_sizes/font_size = 28
text = "이어하기"
visible = false

[node name="QuitButton" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 56)
theme_override_font_sizes/font_size = 28
text = "종료"

[connection signal="pressed" from="VBox/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="VBox/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="VBox/QuitButton" to="." method="_on_quit_pressed"]
