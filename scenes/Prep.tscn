[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/Prep.gd" id="1_prep"]

[sub_resource type="SystemFont" id="SystemFont_prep"]
font_names = PackedStringArray("Apple SD Gothic Neo", "sans-serif")

[node name="Prep" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_prep")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.14, 0.16, 1)

[node name="VBox" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -320.0
offset_top = -220.0
offset_right = 320.0
offset_bottom = 220.0
alignment = 1
theme_override_constants/separation = 20

[node name="StageLabel" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 56
theme_override_fonts/font = SubResource("SystemFont_prep")
text = "스테이지 1 / 5"
horizontal_alignment = 1

[node name="SummaryLabel" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(0.85, 0.9, 1, 1)
theme_override_font_sizes/font_size = 22
theme_override_fonts/font = SubResource("SystemFont_prep")
text = ""
horizontal_alignment = 1
autowrap_mode = 3

[node name="LastResultLabel" type="Label" parent="VBox"]
theme_override_colors/font_color = Color(0.9, 0.85, 0.5, 1)
theme_override_font_sizes/font_size = 20
theme_override_fonts/font = SubResource("SystemFont_prep")
text = ""
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 20)

[node name="BattleButton" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 56)
theme_override_font_sizes/font_size = 28
theme_override_fonts/font = SubResource("SystemFont_prep")
text = "전투 시작"

[node name="TitleButton" type="Button" parent="VBox"]
custom_minimum_size = Vector2(0, 48)
theme_override_font_sizes/font_size = 22
theme_override_fonts/font = SubResource("SystemFont_prep")
text = "타이틀로"

[connection signal="pressed" from="VBox/BattleButton" to="." method="_on_battle_pressed"]
[connection signal="pressed" from="VBox/TitleButton" to="." method="_on_title_pressed"]
